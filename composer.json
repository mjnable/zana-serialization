{
    "name": "mj-zana/serialization",
    "description": "Object normalization, hydration and JSON serialization for Zana applications",
    "type": "library",
    "keywords": ["zana", "serialization", "normalizer", "hydration", "json", "dto"],
    "license": "MIT",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Serialization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Serialization\\Tests\\": "tests/"
        },
        "files": ["tests/Fixtures.php"]
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
