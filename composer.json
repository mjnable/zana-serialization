{
    "name": "zana/serialization",
    "description": "Serialization and normalization support for Zana applications",
    "type": "library",
    "keywords": ["zana", "serialization", "serializer", "normalizer"],
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Serialization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Serialization\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

