{
    "name": "mj-zana/serialization",
    "description": "Object normalization, hydration and JSON serialization for Zana applications",
    "type": "library",
    "keywords": ["zana", "serialization", "normalizer", "hydration", "json", "dto"],
    "license": "MIT",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "mj-zana/core": "^2.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "mj-zana/core": "To register the Serializer with SerializationServiceProvider"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Serialization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Serialization\\Tests\\": "tests/"
        },
        "files": ["tests/Fixtures.php"]
    },
    "repositories": [
        { "type": "path", "url": "../zana-container", "options": { "symlink": true, "versions": { "mj-zana/container": "2.0.0" } } },
        { "type": "path", "url": "../zana-configuration", "options": { "symlink": true, "versions": { "mj-zana/configuration": "2.0.0" } } },
        { "type": "path", "url": "../zana-core", "options": { "symlink": true, "versions": { "mj-zana/core": "2.0.0" } } }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
